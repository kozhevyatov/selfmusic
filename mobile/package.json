{
  "name": "selfmusic-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "build:apk": "eas build -p android --profile production",
    "doctor": "npx expo-doctor",
    "update": "eas update --channel production",
    "ios": "expo run:ios",
    "build:ios": "eas build -p ios --profile production",
    "build:ios:preview": "eas build -p ios --profile preview",
    "submit:ios": "eas submit -p ios --latest"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "*",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "typescript": "~6.0.3"
  }
}
